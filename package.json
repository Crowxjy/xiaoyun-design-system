{
  "name": "xiaoyun-design-system-root",
  "private": true,
  "version": "1.0.0",
  "description": "Xiaoyun Design System Monorepo",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "sync-tokens": "npm run sync-tokens --workspace=@xiaoyun-ds/tokens",
    "sync-icons": "npm run sync-icons --workspace=@xiaoyun-ds/icons",
    "sync-skills": "mkdir -p packages/skills/content && cp -r skills/* packages/skills/content/"
  },
  "devDependencies": {
  },
  "dependencies": {
    "@xiaoyun-ds/components-web": "^1.0.17",
    "@xiaoyun-ds/icons": "^1.0.4",
    "@xiaoyun-ds/skills": "^1.1.1",
    "@xiaoyun-ds/tokens": "^1.0.6"
  }
}
